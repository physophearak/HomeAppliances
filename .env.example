# Paste your deployed Google Apps Script web app URL here.
# Leave empty to run in offline demo mode with local sample data.
VITE_GAS_URL=

# Optional: override the USD -> KHR exchange rate (default 4100).
VITE_KHR_RATE=4100

# PINs for the Manage Stock login. Owner can add products and edit stock;
# Staff can only edit stock. Change these before deploying to real staff.
VITE_OWNER_PIN=1234
VITE_STAFF_PIN=0000
